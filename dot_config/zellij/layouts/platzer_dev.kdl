// Project layout for ~/projects/personal/platzer.dev — auto-applied by the
// sessionizer. Session name is "platzer_dev" (basename | tr '. ' '__'), so this
// file MUST be named platzer_dev.kdl to match.
// Stack: SvelteKit (Svelte 5, Tailwind v4, Bun), deploys to Vercel.
// cwd is set by the sessionizer (--cwd), so panes open in the project root.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    // Editor.
    tab name="nvim" focus=true {
        pane command="nvim"
    }
    // Dev server: Vite (`bun run dev`) auto-starts in the top pane; a free shell
    // in the project root sits below for ad-hoc commands (bun run check, git, …).
    tab name="dev" {
        pane split_direction="horizontal" {
            pane command="bun" {
                args "run" "dev"
            }
            pane
        }
    }
    // Git.
    tab name="git" {
        pane command="lazygit"
    }
}
