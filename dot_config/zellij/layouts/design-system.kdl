// Project layout for ~/projects/personal/design-system (@lplatzer/design-kit) —
// auto-applied by the sessionizer. Session name is "design-system", so this
// file MUST be named design-system.kdl to match.
// Stack: Svelte component library; publish is `v*` tag -> GitHub Packages Action.
// cwd is set by the sessionizer (--cwd), so panes open in the project root.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    // Editor.
    tab name="nvim" focus=true {
        pane command="nvim"
    }
    // Watch-build: `bun run watch` (svelte-package --watch) auto-starts in the
    // top pane so the kit rebuilds on save; a free shell sits below for ad-hoc
    // commands (bun run build, bun run check, cutting a v* release tag, …).
    tab name="watch" {
        pane split_direction="horizontal" {
            pane command="bun" {
                args "run" "watch"
            }
            pane
        }
    }
    // Git — this is where you cut the `v*` release tags that trigger publish.
    tab name="git" {
        pane command="lazygit"
    }
}
