// Project layout for ~/projects/ai/leitwerk — auto-applied by the sessionizer.
// cwd is set by the sessionizer (--cwd), so panes open in the project root.
layout {
    // The compact status bar is injected into every tab via this template.
    // A bare `pane` cannot sit beside `tab` nodes at the layout root — that was
    // the "Cannot have both tabs and panes in the same node" parse error.
    // `children` marks where each tab's own panes are placed.
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    // Working tab: nvim, launched in the project root.
    tab name="nvim" focus=true {
        pane command="nvim"
    }
    // Docker Compose tab: a shell in the project, ready for
    //   docker compose up | logs -f | ps   (docker-compose.yml is here).
    tab name="compose" {
        pane
    }
    // Git tab — lazygit, for parity with the platzer.dev / design-system layouts.
    tab name="git" {
        pane command="lazygit"
    }
}
