// Project layout for ~/projects/ai/rag — auto-applied by the sessionizer.
// Session name is "rag" (basename | tr '. ' '__'), so this file MUST be
// named rag.kdl to match. cwd is set by the sessionizer (--cwd), so panes
// open in the project root.
layout {
    // The compact status bar is injected into every tab via this template.
    // A bare `pane` cannot sit beside `tab` nodes at the layout root, so the
    // bar lives here; `children` marks where each tab's own panes are placed.
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    // Editor.
    tab name="nvim" focus=true {
        pane command="nvim"
    }
    // CLI — a plain shell in the project root for ad-hoc commands.
    tab name="cli" {
        pane
    }
    // Claude session.
    tab name="claude" {
        pane command="claude"
    }
}
