Host *
{{ if and .is_personal (eq .chezmoi.os "darwin") }}
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ else if and .is_personal (eq .chezmoi.os "linux") }}
	IdentityAgent "~/.1password/agent.sock"
{{ end }}
{{ if .is_personal }}
# Azure DevOps: only offer the 1Password key "Azure DevOps SSH key" (RSA; Azure DevOps rejects ed25519).
# The .pub file only selects which agent key to use; the private key stays in 1Password.
Host ssh.dev.azure.com vs-ssh.visualstudio.com
	IdentityFile ~/.ssh/azure-devops.pub
	IdentitiesOnly yes

# Tailnet host: the short name resolves through Tailscale MagicDNS, so no IP or
# tailnet domain is needed here.
Host agent-container
	User root
{{ end }}
