{{- /*
  Windows Terminal settings. A modify_ template: chezmoi passes in the file Terminal
  maintains and these keys are merged into it, so the profiles Terminal generates
  (PowerShell, WSL distributions) and anything set in its UI survive. Windows Terminal
  stays until Rex has a Windows build.
*/ -}}
{{- $s := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $s = fromJsonc .chezmoi.stdin -}}
{{- end -}}
{{- $s = setValueAtPath "profiles.defaults.font.face" "0xProto Nerd Font" $s -}}
{{- $s = setValueAtPath "profiles.defaults.font.size" 12 $s -}}
{{- $s = setValueAtPath "profiles.defaults.colorScheme" "Catppuccin Mocha" $s -}}
{{- $s = setValueAtPath "theme" "dark" $s -}}
{{- $s = setValueAtPath "copyOnSelect" true $s -}}
{{- /* Catppuccin Mocha (catppuccin/windows-terminal), replacing an older copy */ -}}
{{- $mocha := dict
      "name" "Catppuccin Mocha"
      "cursorColor" "#F5E0DC" "selectionBackground" "#585B70"
      "background" "#1E1E2E" "foreground" "#CDD6F4"
      "black" "#45475A" "red" "#F38BA8" "green" "#A6E3A1" "yellow" "#F9E2AF"
      "blue" "#89B4FA" "purple" "#F5C2E7" "cyan" "#94E2D5" "white" "#BAC2DE"
      "brightBlack" "#585B70" "brightRed" "#F38BA8" "brightGreen" "#A6E3A1" "brightYellow" "#F9E2AF"
      "brightBlue" "#89B4FA" "brightPurple" "#F5C2E7" "brightCyan" "#94E2D5" "brightWhite" "#A6ADC8" -}}
{{- $schemes := list -}}
{{- range (get $s "schemes" | default list) -}}
{{-   if ne (get . "name") "Catppuccin Mocha" -}}
{{-     $schemes = append $schemes . -}}
{{-   end -}}
{{- end -}}
{{- $s = set $s "schemes" (append $schemes $mocha) -}}
{{ toPrettyJson $s }}
