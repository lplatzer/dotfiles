# Homebrew (macOS only) — must come first; Homebrew-managed tools need to be in PATH
{{ if eq .chezmoi.os "darwin" }}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end }}

# PATH
export PATH="$HOME/.local/bin:$PATH"

# pnpm (its own installer; global CLIs from `pnpm add -g` land in $PNPM_HOME/bin)
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

# mise (version manager — node, python, ruby, etc.)
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# Pi (coding agent) — a global npm package under mise's node, so `mise activate`
# above normally already puts it on PATH; this is the fallback for a shell where
# the activate hook hasn't run. No OS branch needed: mise is XDG-based on macOS
# too (~/.local/share/mise), not ~/Library/Application Support. Resolved through
# the `lts` alias symlink rather than a pinned version so a node upgrade doesn't
# silently drop pi off PATH.
if ! command -v pi >/dev/null 2>&1; then
  _mise_node_bin="${XDG_DATA_HOME:-$HOME/.local/share}/mise/installs/node/lts/bin"
  [[ -x "$_mise_node_bin/pi" ]] && export PATH="$_mise_node_bin:$PATH"
  unset _mise_node_bin
fi

# eza aliases — only if installed
if command -v eza >/dev/null 2>&1; then
  alias ls='eza'
  alias ll='eza -la'
  alias lt='eza --tree'
fi

# Antidote
{{ if eq .chezmoi.os "darwin" }}
source "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh"
{{ else }}
source "$HOME/.antidote/antidote.zsh"
{{ end }}
antidote load

# Shell integrations
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
# fzf: completion, Ctrl-T (files), Ctrl-R (history) and Alt-C (cd). zsh-vi-mode
# resets keymaps on init, so the bindings are applied again through its hook.
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  zvm_after_init_commands+=('source <(fzf --zsh)')
fi

{{ if .is_personal -}}
# Claude Code profiles: plain `claude` uses ~/.claude; other setups get their own
# CLAUDE_CONFIG_DIR so settings, hooks, skills, plugins and MCP never mix.
# Each profile needs one `/login` (the keychain entry is per config dir).
# ccp <name> [args]: launch the profile in ~/.config/claude-profiles/<name>
ccp() {
  local dir="$HOME/.config/claude-profiles/${1:?usage: ccp <profile> [args]}"
  [[ -d "$dir" ]] || { echo "ccp: no profile at $dir" >&2; return 1; }
  CLAUDE_CONFIG_DIR="$dir" command claude "${@:2}"
}

{{ end -}}

# nvim: from-scratch learning config via NVIM_APPNAME (separate config from LazyVim)
alias vik='NVIM_APPNAME=nvim-lpl nvim'

