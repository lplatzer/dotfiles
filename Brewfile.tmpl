# Homebrew only for what has no vendor installer: the nvim preview libraries (no
# macOS binaries upstream) and AeroSpace (its vendor-preferred tap; the GitHub
# releases are all prereleases). CLIs come from mise (~/.config/mise/config.toml),
# GUI apps from run_once_install-vendor-apps.sh.tmpl.
tap "nikitabobko/tap"

brew "wget"
brew "luarocks"
brew "imagemagick"
brew "ghostscript"
brew "poppler"
brew "ffmpeg"

cask "nikitabobko/tap/aerospace"
