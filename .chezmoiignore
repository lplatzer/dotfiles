# Planning artifacts — not deployed to home directory
Plans/

# Repo docs — not deployed to home directory
README.md
AGENTS.md
# Repo-scoped agent rules: deploying them to ~/CLAUDE.md would load them into
# every Claude Code session under $HOME, not just sessions in this repo.
CLAUDE.md
# Bootstrap one-liner and the fresh-machine wizards, run from the repo; not dotfiles
install.sh
scripts

# Agent config (WS-34) is for work machines only: personal machines keep their own
# ~/.claude and ~/.codex untouched.
{{ if .is_personal }}
.claude
.codex
{{ end }}

# macOS-only configs — skip on Linux
{{ if ne .chezmoi.os "darwin" }}
Brewfile
.config/linearmouse
.aerospace.toml
.local/bin/aerospace-desk
.local/bin/aerospace-desk.ts
Library
{{ end }}

# Linux-only configs — skip on macOS/Windows
{{ if ne .chezmoi.os "linux" }}
install-rex.sh
.config/hypr
.config/uwsm
.config/walker
.config/waybar
.config/mako
{{ end }}

# Windows host: no zsh, no Unix scripts (no interpreter for .sh), no nvim, lazygit or
# mise on the host (dev tooling lives in WSL)
{{ if eq .chezmoi.os "windows" }}
.config/lazygit
.zshrc
.zprofile
.zsh_plugins.txt
.local
.config/mise
.config/nvim
install-antidote.sh
install-brew.sh
install-tools.sh
install-vendor-apps.sh
configure-macos.sh
{{ else }}
# Windows-only
AppData
.glzr
install-windows-apps.ps1
{{ end }}
