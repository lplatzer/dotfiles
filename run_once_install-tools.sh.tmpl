#!/usr/bin/env bash
# No set -e: optional installs failing should warn, not abort the session.

OS="$(uname -s)"
IS_PERSONAL={{ if .is_personal }}true{{ else }}false{{ end }}

# ── Idempotency helpers ──────────────────────────────────────────────────────
# chezmoi keys run_once_ scripts on the *rendered* script hash, so any edit to
# this file re-runs it on every machine. Steps below must therefore be safe to
# re-run. Steps that are genuinely once-per-machine (system upgrades, index
# refreshes) are wrapped in `once <id> -- <cmd...>`, which drops a marker under
# $ONCE_DIR and skips on later applies. A failing step leaves no marker, so it
# is retried next time.
ONCE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi-once"
mkdir -p "$ONCE_DIR"

once() {
  local id="$1"; shift
  [[ "${1:-}" == "--" ]] && shift
  [[ -e "$ONCE_DIR/$id" ]] && return 0
  "$@" && touch "$ONCE_DIR/$id"
}

# Declarative global runtime pin: skip the mise round-trip if already satisfied.
mise_global() {
  local spec="$1" tool="${1%%@*}"
  mise ls --global 2>/dev/null | grep -q "^${tool}[[:space:]]" || mise use --global "$spec"
}

# ── macOS ────────────────────────────────────────────────────────────────────
# Homebrew + brew bundle live in run_onchange_before_install-brew.sh.tmpl (tracks Brewfile
# changes independently so edits here don't trigger a full brew bundle re-run).
if [[ "$OS" == "Darwin" ]]; then

  # mise: activate and install runtimes (mise installed via Brewfile)
  eval "$(mise activate bash)"
  mise_global node@lts
  mise_global python@latest
  mise_global zig@latest

  # rustup: initialise stable toolchain so cargo is available
  command -v rustup >/dev/null 2>&1 && rustup default stable 2>/dev/null || true

  # ty — Astral Python type checker / LSP (alpha), used by Neovim's basedpyright+ty setup
  command -v ty >/dev/null 2>&1 || uv tool install ty

  # bun
  if ! command -v bun >/dev/null 2>&1; then
    curl -fsSL https://bun.sh/install | bash
  fi
  export PATH="$HOME/.bun/bin:$PATH"

  # Claude Code
  command -v claude >/dev/null 2>&1 || bun install --global @anthropic-ai/claude-code

  # Codex CLI (OpenAI)
  command -v codex >/dev/null 2>&1 || npm install -g @openai/codex || echo "codex install failed — install manually" >&2

# ── Arch Linux / CachyOS ─────────────────────────────────────────────────────
elif command -v pacman >/dev/null 2>&1; then
  export PATH="$HOME/.local/bin:$PATH"
  mkdir -p "$HOME/.local/bin"

  [[ "$SHELL" != "$(which zsh)" ]] && chsh -s "$(which zsh)" || true

  once pacman-syu -- sudo pacman -Syu --noconfirm
  sudo pacman -S --noconfirm --needed \
    zsh kitty git wget curl chezmoi mise \
    eza zoxide starship \
    fzf fd ripgrep \
    neovim lazygit \
    luarocks imagemagick ghostscript \
    go rustup zig uv \
    python python-pip \
    nodejs npm pnpm \
    dotnet-sdk \
    uwsm \
    hyprland xdg-desktop-portal-hyprland wl-clipboard cliphist \
    nautilus gvfs gvfs-smb \
    waybar \
    mako libnotify \
    hyprlock hypridle \
    grim slurp satty \
    pipewire-pulse wireplumber pamixer brightnessctl \
    btop fastfetch \
    noto-fonts noto-fonts-emoji ttf-jetbrains-mono-nerd \
    base-devel github-cli \
    wireshark-qt

  # walker + elephant providers (AUR) — bound to Super+Space in Hyprland
  # walker-bin pulls in elephant (source); install only provider plugins as -bin to avoid conflict.
  if command -v paru >/dev/null 2>&1; then
    paru -S --noconfirm --needed walker-bin \
      elephant-desktopapplications-bin \
      elephant-providerlist-bin \
      elephant-runner-bin \
      elephant-files-bin \
      elephant-calc-bin \
      elephant-websearch-bin \
      elephant-clipboard-bin \
      elephant-windows-bin
  else
    echo "walker/elephant not installed — run: paru -S walker-bin elephant-desktopapplications-bin" >&2
  fi

  # Antidote (not in official repos)
  if [[ ! -d "$HOME/.antidote" ]]; then
    git clone --depth=1 https://github.com/mattmc3/antidote.git "$HOME/.antidote"
  fi

  # Wireshark: add current user to capture group
  sudo gpasswd -a "$USER" wireshark 2>/dev/null || true

  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"

  command -v rustup >/dev/null 2>&1 && rustup default stable 2>/dev/null || true

  # ty — Astral Python type checker / LSP (alpha), used by Neovim's basedpyright+ty setup
  if command -v uv >/dev/null 2>&1; then
    command -v ty >/dev/null 2>&1 || uv tool install ty
  fi

  # mise: install runtimes
  if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)" 2>/dev/null || true
    mise_global node@lts
    mise_global python@latest
  fi

  if command -v npm >/dev/null 2>&1; then
    command -v tree-sitter >/dev/null 2>&1 || sudo npm install -g tree-sitter-cli
  fi

  # bun
  if ! command -v bun >/dev/null 2>&1; then
    curl -fsSL https://bun.sh/install | bash
  fi
  export PATH="$HOME/.bun/bin:$PATH"

  # Claude Code
  command -v claude >/dev/null 2>&1 || bun install --global @anthropic-ai/claude-code

  # Codex CLI
  # if possible, move to bun in the future
  if command -v npm >/dev/null 2>&1; then
    command -v codex >/dev/null 2>&1 || sudo npm install -g @openai/codex || echo "codex install failed — install manually" >&2
  fi

  if [[ "$IS_PERSONAL" == "true" ]]; then
    # 1password-cli: chaotic-aur on CachyOS, otherwise manual
    if ! command -v op >/dev/null 2>&1; then
      if command -v paru >/dev/null 2>&1; then
        paru -S --noconfirm 1password-cli
      else
        echo "1password-cli not installed — install via AUR (paru -S 1password-cli) manually." >&2
      fi
    fi

    # Communication & personal apps (AUR)
    if command -v paru >/dev/null 2>&1; then
      paru -S --noconfirm --needed telegram-desktop signal-desktop whatsapp-for-linux obsidian
    fi

    # Ollama
    command -v ollama >/dev/null 2>&1 || curl -fsSL https://ollama.ai/install.sh | sh || echo "ollama install failed — install manually" >&2
  fi

else
  echo "Unsupported OS/package manager. Install tools manually." >&2
fi
